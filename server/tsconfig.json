{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": ["./**/*.js"],
  "exclude": ["node_modules"]
}
